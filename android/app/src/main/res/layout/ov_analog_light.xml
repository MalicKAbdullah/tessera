<?xml version="1.0" encoding="utf-8"?>
<!-- AnalogClock ignores its own padding, so the box positions it. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/analog_box"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <AnalogClock
        android:id="@+id/analog"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:dial="@drawable/analog_dial_blank"
        android:hand_hour="@drawable/hand_hour_light"
        android:hand_minute="@drawable/hand_minute_light" />
</FrameLayout>
